+import React from "react";
+
+/**
+ * Mobile-friendly "quick add" dropdown for free-text clinical fields.
+ * Uses the native <select> (OS picker on phones). The clinician's choice is appended to the text field;
+ * nothing is ever filled unless the clinician taps an option. The text field stays fully editable.
+ * `exclusive` options (e.g. "None", "Nil") replace the whole value instead of being appended.
+ */
+export default function QuickPick({
+  options,
+  exclusive = [],
+  value,
+  onChange,
+  placeholder = "+ Quick add…",
+  label,
+}: {
+  options: string[];
+  exclusive?: string[];
+  value: string;
+  onChange: (next: string) => void;
+  placeholder?: string;
+  label?: string;
+}) {
+  const handlePick = (picked: string) => {
+    if (!picked) return;
+    const current = (value || "").trim();
+    const lowerCurrent = current.toLowerCase();
+    if (exclusive.includes(picked) || !current || exclusive.some((x) => x.toLowerCase() === lowerCurrent)) {
+      onChange(picked);
+      return;
+    }
+    if (lowerCurrent.split(/[,;\n]/).some((p) => p.trim() === picked.toLowerCase())) return; // already there
+    onChange(`${current}, ${picked}`);
+  };
+  return (
+    <select
+      aria-label={label || placeholder}
+      value=""
+      onChange={(e) => handlePick(e.target.value)}
+      className="w-full min-h-[44px] sm:min-h-0 px-3 py-2 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg text-base sm:text-xs text-slate-600 dark:text-slate-300 focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer"
+    >
+      <option value="">{placeholder}</option>
+      {options.map((o) => (
+        <option key={o} value={o}>
+          {o}
+        </option>
+      ))}
+    </select>
+  );
+}
