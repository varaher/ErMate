+  c = await call(db, "scribe_chat", { uid: "u1", email: "a@x.com", email_verified: false }, 200, { success: true });
+  t("unverified legacy user: gated, NOT granted credits", !c.nexted && db.store["users/u1"].aiCredits === undefined);
+
