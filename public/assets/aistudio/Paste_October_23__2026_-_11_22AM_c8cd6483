+import { readFileSync } from "fs";
+import { initializeApp } from "firebase/app";
+import { getFirestore, doc, setDoc, setLogLevel } from "firebase/firestore";
+setLogLevel("silent");
+import { sanitizeForFirestore } from "./src/utils/firestoreSanitizer";
+
+let pass = 0, fail = 0;
+const t = (n: string, ok: boolean) => { ok ? pass++ : (fail++, console.log("FAIL", n)); };
+
+const db = getFirestore(initializeApp({ projectId: "demo-save-audit", apiKey: "k" }));
+// Firestore validates data BEFORE any network call: an invalid doc rejects at once; a valid one just waits.
+async function validates(data: any): Promise<boolean> {
+  try {
+    const r = await Promise.race([
+      setDoc(doc(db, "cases/c1/addenda/a1"), data).then(() => "ok", (e: any) => (e?.code === "invalid-argument" ? "invalid" : "other")),
+      new Promise<string>(res => setTimeout(() => res("waiting"), 700)),
+    ]);
+    return r !== "invalid";
+  } catch (e: any) {
+    return e?.code !== "invalid-argument";
+  }
+}
+
+(async () => {
+  // The audit log built on every edit holds whole sections of the case. A triage-pending patient has
+  // triageCategory === undefined in memory.
+  const audit = {
+    id: "add-1", type: "edit", fieldsChanged: ["patient"],
+    previousValues: { patient: { name: "N/A/U", triageCategory: undefined, bed: undefined } },
+    newValues: { patient: { name: "N/A/U", age: 40, triageCategory: undefined } },
+    addedAt: "2026-10-21T00:00:00Z", addedBy: "u1",
+  };
+  t("RAW audit log with undefined is rejected by Firestore (the bug)", !(await validates(audit)));
+  t("sanitized audit log is accepted", await validates(sanitizeForFirestore(audit)));
+
+  const app = readFileSync("src/App.tsx", "utf8");
+  t("addendum write is sanitized", app.includes("setDoc(addendumRef, sanitizeForFirestore(auditLog))"));
+  t("raw addendum write no longer present in case save", !app.includes("await setDoc(addendumRef, auditLog);\n\n      // Trusted Logbook"));
+  t("audit failure cannot fail a saved case", /Case saved, but the edit audit entry failed/.test(app));
+  t("primary case write still throws on failure", /await setDoc\(doc\(db, "cases", caseToSave\.id\), sanitizeForFirestore\((?:caseToSave|writePayload)\), \{ merge: true \}\);[\s\S]{0,200}?const previousCase = latestCasesRef/.test(app) && app.includes('console.error("Error saving case or audit trail:", err);') && app.includes("throw err;"));
+
+  const sheet = readFileSync("src/components/CaseSheetView.tsx", "utf8");
+  t("NOT SAVED shows the reason", sheet.includes("saveErrorReason") && sheet.includes("describeSaveError"));
+  t("reason set for autosave and for Save button", (sheet.match(/setSaveErrorReason\(describeSaveError\(err\)\)/g) || []).length === 2);
+
+  console.log(`verify_case_save_audit_undefined: ${pass} passed, ${fail} failed`);
+  process.exit(fail ? 1 : 0);
+})();
