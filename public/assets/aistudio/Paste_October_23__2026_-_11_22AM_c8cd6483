+++ b/verify_secondary_normals_honest.ts
@@ -0,0 +1,52 @@
+import fs from "fs";
+import { applySecondaryNormals, adultSecondaryNormals, documentedGcsOf, recordedSecondary, SECONDARY_KEYS } from "./src/utils/secondaryNormals";
+
+let pass = 0, fail = 0;
+const t = (n: string, ok: boolean) => { ok ? pass++ : (fail++, console.log("FAIL", n)); };
+const base = (over: any = {}) => ({ secondarySurvey: {}, secondaryAssessment: "", vitals: {}, primaryAssessment: {}, ...over });
+
+// A. no invented GCS
+let r = applySecondaryNormals(base(), SECONDARY_KEYS);
+t("no GCS documented: CNS text has NO GCS value", !/GCS/i.test(r.secondarySurvey.cns));
+t("blank case: all 6 systems filled", r.filled.length === 6 && SECONDARY_KEYS.every(k => r.secondarySurvey[k]));
+r = applySecondaryNormals(base({ vitals: { gcs: "14" } }), ["cns"]);
+t("documented GCS 14 is used, not 15", r.secondarySurvey.cns.includes("GCS 14/15") && !r.secondarySurvey.cns.includes("GCS 15/15"));
+t("GCS read from primary narrative", documentedGcsOf(base({ primaryAssessment: { disability: "GCS 9 E2V3M4" } })) === 9);
+t("junk GCS ignored", documentedGcsOf(base({ vitals: { gcs: "abc" } })) === null);
+
+// B. never overwrite what the doctor wrote
+r = applySecondaryNormals(base({ secondarySurvey: { cvs: "Systolic murmur 3/6 at apex" }, secondaryAssessment: "CVS: Systolic murmur 3/6 at apex" }), ["cvs"]);
+t("typed CVS finding kept", r.secondarySurvey.cvs === "Systolic murmur 3/6 at apex" && r.filled.length === 0 && r.kept.includes("cvs"));
+t("no contradiction in narrative", !/no murmurs/i.test(r.secondaryAssessment));
+// narrative-only record (box empty) must also be respected
+r = applySecondaryNormals(base({ secondaryAssessment: "CVS: Systolic murmur 3/6 at apex\nRS: Bilateral crepts" }), SECONDARY_KEYS);
+t("narrative-only CVS finding is respected", /Systolic murmur/.test(r.secondarySurvey.cvs) && !/no murmurs/i.test(r.secondarySurvey.cvs));
+t("narrative-only RS finding is respected", /crepts/.test(r.secondarySurvey.respiratory) && !/Vesicular breath sounds/.test(r.secondarySurvey.respiratory));
+t("narrative keeps the abnormal findings", /Systolic murmur/.test(r.secondaryAssessment) && /crepts/.test(r.secondaryAssessment));
+t("only the unrecorded systems were filled", r.filled.length === 4 && !r.filled.includes("cvs") && !r.filled.includes("respiratory"));
+t("narrative has no duplicated system lines", (r.secondaryAssessment.match(/^CVS:/gm) || []).length === 1 && (r.secondaryAssessment.match(/^RS:/gm) || []).length === 1);
+
+// C. presets: one click per system, repeat clicks are harmless
+let c: any = base();
+for (let i = 0; i < 3; i++) { const x = applySecondaryNormals(c, ["abdomen"]); c = { ...c, secondarySurvey: x.secondarySurvey, secondaryAssessment: x.secondaryAssessment }; }
+t("clicking a preset 3 times writes it once", (c.secondaryAssessment.match(/PA:/g) || []).length === 1);
+r = applySecondaryNormals(base({ secondarySurvey: { abdomen: "Tender RIF, guarding" } }), ["abdomen"]);
+t("preset does not replace typed abdomen", r.secondarySurvey.abdomen === "Tender RIF, guarding");
+t("recordedSecondary sees both sources", Object.keys(recordedSecondary(base({ secondarySurvey: { cns: "x" }, secondaryAssessment: "RS: y" }))).sort().join() === "cns,respiratory");
+t("whitespace-only box counts as blank", applySecondaryNormals(base({ secondarySurvey: { cvs: "   " } }), ["cvs"]).filled.includes("cvs"));
+
+// D. input is not mutated
+const orig = base({ secondarySurvey: { cvs: "murmur" } }); const snap = JSON.stringify(orig);
+applySecondaryNormals(orig, SECONDARY_KEYS);
+t("input case not mutated", JSON.stringify(orig) === snap);
+
+// E. wiring
+const code = fs.readFileSync("src/components/CaseSheetView.tsx", "utf8");
+t("Mark-normal uses the shared helper", code.includes("applySecondaryNormals(prev, SECONDARY_KEYS)"));
+t("presets use the shared helper and are disabled when recorded", code.includes("applySecondaryNormals(prev, [preset.key])") && code.includes("disabled={alreadyRecorded}"));
+t("no hard-coded 'GCS 15/15' left in CaseSheetView", !/GCS 15\/15\. Higher/.test(code) && !code.includes("const effectiveGcs"));
+t("old replace-on-click preset code is gone", !code.includes("const cleanText = preset.text"));
+t("general template unchanged text", adultSecondaryNormals(null).general.startsWith("Conscious, alert, and oriented."));
+
+console.log(`verify_secondary_normals_honest: ${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);