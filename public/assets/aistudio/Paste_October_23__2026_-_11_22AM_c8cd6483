+import fs from "fs";
+import { diffForWrite } from "./src/utils/changedFields";
+import { isExplicitPrecipitatingEvent } from "./server/scribeChatTurn";
+const log = console.log; console.log = () => {};
+let pass = 0, fail = 0;
+const ok = (c: boolean, m: string) => { if (c) pass++; else { fail++; log("FAIL", m); } };
+const base = { id: "c1", vitals: { hr: "80", bp: "120/80" }, sampleHistory: { hpi: "old", symptoms: "fever", events: "" }, investigations: [{ n: 1 }], status: "Active" };
+// device B only changed hpi; its copy of vitals is stale
+const next = { ...base, sampleHistory: { ...base.sampleHistory, hpi: "new" } };
+const d: any = diffForWrite(base, next);
+ok(JSON.stringify(d) === JSON.stringify({ sampleHistory: { hpi: "new" } }), "only changed leaf is written");
+ok(!("vitals" in d), "stale untouched vitals not written");
+ok(Object.keys(diffForWrite(base, { ...base })).length === 0, "no change => empty diff");
+const d2: any = diffForWrite(base, { ...base, investigations: [{ n: 1 }, { n: 2 }] });
+ok(d2.investigations.length === 2 && Object.keys(d2).length === 1, "array change written whole");
+const d3: any = diffForWrite(base, { ...base, sampleHistory: { ...base.sampleHistory, events: undefined } });
+ok(Object.keys(d3).length === 0, "undefined never deletes");
+const d4: any = diffForWrite(base, { ...base, sampleHistory: { ...base.sampleHistory, hpi: "" } });
+ok(d4.sampleHistory.hpi === "", "clearing a field is a real change");
+for (const t of ["Collapsed at home before arrival", "Exertional chest pain while climbing stairs", "Syncope at home", "Fall from stairs"])
+  ok(isExplicitPrecipitatingEvent(t), "event accepted: " + t);
+for (const t of ["Fever for 3 days", "vomiting since yesterday", "none"])
+  ok(!isExplicitPrecipitatingEvent(t), "event rejected: " + t);
+const fb = fs.readFileSync("src/firebase.ts", "utf8");
+ok(/persistentLocalCache/.test(fb) && /persistentMultipleTabManager/.test(fb) && /catch/.test(fb), "offline cache with safe fallback");
+const app = fs.readFileSync("src/App.tsx", "utf8");
+ok(/canDeltaWrite/.test(app) && /diffForWrite\(options\.baseCase/.test(app), "autosave uses delta write");
+ok(/never silently replaced by extraction/.test(app), "typed HPI protected");
+const sheet = fs.readFileSync("src/components/CaseSheetView.tsx", "utf8");
+ok(/autosave: true, baseCase: base/.test(sheet), "sheet passes base copy");
+log(`verify_autosave_hpi_hardening: ${pass} pass, ${fail} fail`); process.exit(fail ? 1 : 0);
