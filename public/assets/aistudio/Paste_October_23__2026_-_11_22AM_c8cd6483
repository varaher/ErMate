+import { mapExtractionToCaseSheetFields } from "./server/scribeChatTurn";
+import { cleanExtractionOutput } from "./server/extractionCleanup";
+const orig = console.log; console.log = () => {};
+let pass = 0, fail = 0;
+const ok = (c: boolean, m: string) => { if (c) pass++; else { fail++; orig("FAIL", m); } };
+const run = (raw: any, text: string, ex: any = {}) => mapExtractionToCaseSheetFields(cleanExtractionOutput(raw), raw, ex, text) as any;
+let f = run({ chiefComplaint: "Fever", symptoms: "fever and cough for 3 days" }, "fever and cough for 3 days");
+ok(f.sampleHistory?.hpi === "Fever and cough for 3 days", "composed HPI from symptoms");
+ok(f.hpi === f.sampleHistory?.hpi, "top-level hpi matches");
+f = run({ chiefComplaint: "Fever", symptoms: "fever", hpi: "Fever for 3 days with cough." }, "fever");
+ok(f.sampleHistory?.hpi === "Fever for 3 days with cough.", "model hpi bridged into sampleHistory");
+f = run({ chiefComplaint: "Fever", symptoms: "fever" }, "fever", { sampleHistory: { hpi: "Typed by doctor" } });
+ok(f.sampleHistory?.hpi === "Typed by doctor" && f.hpi === undefined, "existing HPI never overwritten");
+f = run({}, "bp 120/80");
+ok(f.hpi === undefined && !f.sampleHistory?.hpi, "nothing dictated => no HPI invented");
+f = run({ chiefComplaint: "RTA", symptoms: "head pain", events: "Road traffic accident, 2 hours ago" }, "RTA two hours ago head pain");
+ok(!!f.sampleHistory?.hpi && /head pain/i.test(f.sampleHistory.hpi), "trauma HPI includes symptoms");
+f = run({ chiefComplaint: "Fever", symptoms: "fever" }, "fever", { sampleHistory: { hpi: "Typed" } });
+ok(f.sampleHistory?.hpi === "Typed", "existing preserved in sampleHistory");
+orig(`verify_hpi_autowrite: ${pass} pass, ${fail} fail`); process.exit(fail ? 1 : 0);
