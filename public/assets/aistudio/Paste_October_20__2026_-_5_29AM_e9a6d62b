+t("hold expires after TTL / generation change (patient switch clears it)", !isHeldUpdateExpired(held, 1, 1000 + 1000) && isHeldUpdateExpired(held, 2, 2000) && isHeldUpdateExpired(held, 1, 1000 + HELD_UPDATE_TTL_MS + 1));
