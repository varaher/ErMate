+  return {
+    store,
+    collection: (c: string) => ({ doc: (id?: string) => mkRef(`${c}/${id ?? "auto" + ++n}`) }),
+    runTransaction: (fn: any) => {
+      const run = queue.then(async () => {
+        const w: Array<() => void> = [];
+        const tx = {
+          get: async (r: any) => r.get(),
+          update: (r: any, d: any) => w.push(() => { store[r.path] = { ...store[r.path], ...d }; }),
