      if (lifecycle.signal.aborted || auth.currentUser?.uid !== uid) return;
      if (snapshot.exists()) {
        const d = snapshot.data();
        const fields = { aiCredits: d.aiCredits, subscriptionTier: d.subscriptionTier, tierExpiresAt: d.tierExpiresAt };
