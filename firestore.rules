rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────

    function uid() {
      return request.auth.uid;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function getMember(deptId) {
      return get(/databases/$(database)/documents/departments/$(deptId)/members/$(uid())).data;
    }

    function getRole(deptId) {
      return getMember(deptId).role;
    }

    function isHOD(deptId) {
      return getRole(deptId) == 'hod';
    }

    function isConsultant(deptId) {
      return getRole(deptId) == 'consultant';
    }

    function isResident(deptId) {
      return getRole(deptId) == 'resident';
    }

    function isMember(deptId) {
      return exists(/databases/$(database)/documents/departments/$(deptId)/members/$(uid()));
    }

    // ── Cases Rules ──────────────────────────────────────────

    match /cases/{caseId} {
      allow read, create, update, delete: if true;

      // Addenda subcollection under cases
      match /addenda/{addendumId} {
        allow read, create, update, delete: if true;
      }
    }

    // ── Departments Cases Rules ────────────────────────────────

    match /departments/{deptId}/cases/{caseId} {
      allow read, create, update, delete: if true;

      match /addenda/{addendumId} {
        allow read, create, update, delete: if true;
      }
    }

    // ── Other Standard Collections (Preserved for App Stability) ──

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && isOwner(userId)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().role is string && incoming().role.size() <= 100
        && incoming().hospital is string && incoming().hospital.size() <= 100
        && (incoming().get('aiCredits', 0) is int)
        && (incoming().get('streak', 0) is int)
        && (incoming().get('subscriptionTier', '') is string);
      allow update: if isLoggedIn()
        && (
          // HOD, Owner or varahgrp@gmail.com can update any user's profile including role
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hod', 'owner', 'HOD / Shift Lead', 'HOD / Department Lead', 'Senior Consultant'] || request.auth.token.email == 'varahgrp@gmail.com')
          ||
          // User updating their own profile EXCEPT role cannot be changed unless it matches existing role
          (isOwner(userId) && (!('role' in incoming()) || incoming().role == existing().role))
        )
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().role is string && incoming().role.size() <= 100
        && incoming().hospital is string && incoming().hospital.size() <= 100
        && (incoming().get('aiCredits', 0) is int)
        && (incoming().get('streak', 0) is int)
        && (incoming().get('subscriptionTier', '') is string);
    }

    // Role Change Requests collection (ErMate Rule 10 - HOD approval workflow for role elevation)
    match /roleChangeRequests/{requestId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && incoming().requestedBy == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isLoggedIn()
        && (
          incoming().requestedBy == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hod', 'owner', 'HOD / Shift Lead', 'HOD / Department Lead', 'Senior Consultant']
          || request.auth.token.email == 'varahgrp@gmail.com'
        );
      allow delete: if false;
    }

    // Role Change Audit Log collection (NABH Compliance)
    match /roleChangeLog/{logId} {
      allow read: if isLoggedIn()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hod', 'owner', 'HOD / Shift Lead', 'HOD / Department Lead', 'Senior Consultant']
          || request.auth.token.email == 'varahgrp@gmail.com'
        );
      allow create: if isLoggedIn();
      allow update, delete: if false;
    }

    // Handovers collection
    match /handovers/{handoverId} {
      allow read, create, update, delete: if true;
    }

    // Quick Paste / Handover Roster Patients collection (Synced across desktop & mobile)
    match /quick_paste_patients/{itemId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isLoggedIn();
    }

    match /handoverPatients/{patientId} {
      allow read, create, update, delete: if true;
    }

    match /handover_patients/{patientId} {
      allow read, create, update, delete: if true;
    }

    // Team members collection
    match /team_members/{memberId} {
      allow read: if isLoggedIn();
      allow delete: if isLoggedIn() && isValidId(memberId);
      allow create: if isLoggedIn()
        && isValidId(memberId)
        && incoming().id is string && incoming().id.size() <= 100
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().role is string && incoming().role.size() <= 100
        && incoming().status is string && incoming().status.size() <= 100
        && incoming().shift is string && incoming().shift.size() <= 100
        && incoming().hospital is string && incoming().hospital.size() <= 100;
      allow update: if isLoggedIn()
        && isValidId(memberId)
        && (
          (!('role' in incoming()) || incoming().role == existing().role || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hod', 'owner', 'HOD / Shift Lead', 'HOD / Department Lead'] || request.auth.token.email == 'varahgrp@gmail.com'))
        )
        && incoming().id is string && incoming().id.size() <= 100
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().role is string && incoming().role.size() <= 100
        && incoming().status is string && incoming().status.size() <= 100
        && incoming().shift is string && incoming().shift.size() <= 100
        && incoming().hospital is string && incoming().hospital.size() <= 100;
    }

    // Hospital subscriptions collection
    match /hospital_subscriptions/{hospitalId} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn()
        && incoming().id is string && incoming().id.size() <= 128
        && incoming().hospital is string && incoming().hospital.size() <= 100
        && incoming().subscriptionTier is string && incoming().subscriptionTier.size() <= 100
        && incoming().active is bool;
    }

    // Hospital shifts configuration collection
    match /hospital_shifts/{hospitalId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isLoggedIn();
    }

    // Contributions collection
    match /contributions/{contributionId} {
      allow read: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.submitterEmail == null ||
        !('email' in request.auth.token) ||
        request.auth.token.email == null ||
        resource.data.submitterEmail.lower() == request.auth.token.email.lower()
      );
      allow create: if isLoggedIn()
        && isValidId(contributionId)
        && incoming().id == contributionId
        && incoming().title is string && incoming().title.size() <= 150
        && incoming().mnemonic is string && incoming().mnemonic.size() <= 100
        && incoming().category is string && incoming().category.size() <= 100
        && incoming().breakdown is string && incoming().breakdown.size() <= 2000
        && incoming().status == 'pending'
        && incoming().submittedBy is string && incoming().submittedBy.size() <= 100
        && (
          !('email' in request.auth.token) ||
          request.auth.token.email == null ||
          incoming().submitterEmail.lower() == request.auth.token.email.lower()
        );
      allow update: if isLoggedIn()
        && isValidId(contributionId)
        && (
          (incoming().status == 'approved' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          (
            (
              resource.data.submitterEmail == null ||
              !('email' in request.auth.token) ||
              request.auth.token.email == null ||
              resource.data.submitterEmail.lower() == request.auth.token.email.lower()
            ) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mnemonic', 'category', 'breakdown', 'explanation'])
          )
        );
    }

    // ── Mortality Audits Rules (Confidential Medico-Legal Records) ──
    match /mortalityAudits/{auditId} {
      // Only HOD and consultants can read
      allow read: if request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hod', 'consultant']
          || request.auth.token.email == 'varahgrp@gmail.com'
        );

      // Only HOD can write
      allow write: if request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hod'
          || request.auth.token.email == 'varahgrp@gmail.com'
        );

      // Nobody can delete
      allow delete: if false;
    }

    // ── Bound Chat Sessions Collection ──────────────
    match /chatSessions/{sessionId} {
      allow read, create, update, delete: if true;
    }
  }
}
