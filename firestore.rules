rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────

    function uid() {
      return request.auth.uid;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@.]+$');
    }

    // True platform-level superadmin only. The ONLY identity allowed to cross
    // hospital boundaries.
    function isPlatformAdmin() {
      return isLoggedIn() && ('email' in request.auth.token) && request.auth.token.email == 'varahgrp@gmail.com';
    }

    // Deprecated. Kept only so older rule references cannot silently grant
    // HOD power: it now means platform admin, nothing else. Hospital-level
    // admin authority is isHospitalAdminFor() on a verified team_members/{uid}.
    function isAdminRole() {
      return isPlatformAdmin();
    }

    // ROOT-OF-TRUST: hospital scoping comes ONLY from the verified
    // team_members/{uid} record, never from the user-editable users.hospital.
    function sameHospital(docHospital) {
      return isLoggedIn() && (canAccessLegacyHospital(docHospital) || isPlatformAdmin());
    }

    function isExactAdminRole(roleStr) {
      return roleStr is string && roleStr.trim().lower() in [
        'hod',
        'hod / department lead',
        'hod / shift lead'
      ];
    }

    // ── Membership helpers (team_members/{uid} is the root of trust) ──

    function checkActiveMember(m, hospId) {
      return m.get('status', '') in ['active', 'Active (Joined)']
        && m.get('membershipVerified', false) == true
        && (
          m.get('hospitalId', '') == hospId
          || (
            m.get('hospitalId', null) == null
            && m.get('hospital', '') == hospId
          )
        );
    }

    function hasActiveHospitalMembership(userId, hospId) {
      return isLoggedIn()
        && userId != null
        && hospId is string
        && hospId.size() > 0
        && exists(/databases/$(database)/documents/team_members/$(userId))
        && checkActiveMember(get(/databases/$(database)/documents/team_members/$(userId)).data, hospId);
    }

    function checkAnyActiveMember(m) {
      return m.get('status', '') in ['active', 'Active (Joined)']
        && m.get('membershipVerified', false) == true
        && (
          (m.get('hospitalId', null) is string && m.get('hospitalId', '') != '')
          || (m.get('hospital', null) is string && m.get('hospital', '') != '')
        );
    }

    function userHasActiveHospitalMembership(userId) {
      return isLoggedIn()
        && userId != null
        && exists(/databases/$(database)/documents/team_members/$(userId))
        && checkAnyActiveMember(get(/databases/$(database)/documents/team_members/$(userId)).data);
    }

    function checkLegacyMember(m, hospitalValue) {
      return m.get('status', '') in ['active', 'Active (Joined)']
        && m.get('membershipVerified', false) == true
        && (
          m.get('hospitalId', '') == hospitalValue
          || m.get('hospitalName', '') == hospitalValue
          || m.get('hospital', '') == hospitalValue
          || (
            m.get('legacyHospitalNames', null) is list
            && hospitalValue in m.get('legacyHospitalNames', [])
          )
        );
    }

    function canAccessLegacyHospital(hospitalValue) {
      return isLoggedIn() && (
        isPlatformAdmin()
        || (
          hospitalValue is string && hospitalValue.size() > 0
          && exists(/databases/$(database)/documents/team_members/$(uid()))
          && checkLegacyMember(get(/databases/$(database)/documents/team_members/$(uid())).data, hospitalValue)
        )
      );
    }

    function checkAdminMember(m, hospId) {
      return m.get('status', '') in ['active', 'Active (Joined)']
        && m.get('membershipVerified', false) == true
        && isExactAdminRole(m.get('role', ''))
        && (
          m.get('hospitalId', '') == hospId
          || m.get('hospital', '') == hospId
          || m.get('hospitalName', '') == hospId
          || (
            m.get('legacyHospitalNames', null) is list
            && hospId in m.get('legacyHospitalNames', [])
          )
        );
    }

    function isHospitalAdminFor(hospId) {
      return isLoggedIn() && (
        isPlatformAdmin()
        || (
          hospId is string
          && hospId.size() > 0
          && exists(/databases/$(database)/documents/team_members/$(uid()))
          && checkAdminMember(get(/databases/$(database)/documents/team_members/$(uid())).data, hospId)
        )
      );
    }

    function checkRotaManagerMember(m, hospId) {
      return m.get('status', '') in ['active', 'Active (Joined)']
        && (
          m.get('isRotaManager', false) == true
          || m.get('rotaManager', false) == true
          || (m.get('membershipVerified', false) == true && isExactAdminRole(m.get('role', '')))
          || m.get('isTeamAdmin', false) == true
          || m.get('teamRole', '') == 'admin'
        )
        && (
          m.get('hospitalId', '') == hospId
          || m.get('hospital', '') == hospId
          || m.get('hospitalName', '') == hospId
          || (
            m.get('legacyHospitalNames', null) is list
            && hospId in m.get('legacyHospitalNames', [])
          )
        );
    }

    function isRotaManagerFor(hospId) {
      return isLoggedIn() && (
        isPlatformAdmin()
        || (
          hospId is string
          && hospId.size() > 0
          && exists(/databases/$(database)/documents/team_members/$(uid()))
          && checkRotaManagerMember(get(/databases/$(database)/documents/team_members/$(uid())).data, hospId)
        )
      );
    }

    function isValidHospitalCaseCreate(data) {
      return data.get('workspaceType', '') == 'hospital'
        && data.get('createdByUid', '') == uid()
        && data.get('ownerUid', null) == null
        && data.get('hospitalId', '') is string
        && data.get('hospitalId', '').size() > 0
        && hasActiveHospitalMembership(uid(), data.get('hospitalId', ''));
    }

    function isValidIndividualCaseCreate(data) {
      return data.get('workspaceType', '') == 'individual'
        && data.get('createdByUid', '') == uid()
        && data.get('ownerUid', '') == uid()
        && data.get('hospitalId', null) == null
        && !userHasActiveHospitalMembership(uid());
    }

    function canAccessCase(caseData) {
      return isLoggedIn() && (
        isPlatformAdmin()
        || (
          caseData.get('workspaceType', '') == 'hospital'
          && hasActiveHospitalMembership(uid(), caseData.get('hospitalId', ''))
        )
        || (
          caseData.get('workspaceType', '') == 'individual'
          && caseData.get('ownerUid', '') == uid()
        )
        || (
          !('workspaceType' in caseData)
          && canAccessLegacyHospital(caseData.get('hospital', ''))
        )
      );
    }

    function isValidHospitalSessionCreate(data) {
      return data.get('workspaceType', '') == 'hospital'
        && data.get('ownerUid', '') == uid()
        && data.get('hospitalId', '') is string
        && data.get('hospitalId', '').size() > 0
        && data.get('linkedCaseId', null) == null
        && hasActiveHospitalMembership(uid(), data.get('hospitalId', ''));
    }

    function isValidIndividualSessionCreate(data) {
      return data.get('workspaceType', '') == 'individual'
        && data.get('ownerUid', '') == uid()
        && data.get('hospitalId', null) == null
        && data.get('linkedCaseId', null) == null
        && !userHasActiveHospitalMembership(uid());
    }

    function canAccessSession(sessionData) {
      return isLoggedIn() && (
        isPlatformAdmin()
        || (
          sessionData.get('linkedCaseId', null) != null
          && exists(/databases/$(database)/documents/cases/$(sessionData.linkedCaseId))
          && canAccessCase(get(/databases/$(database)/documents/cases/$(sessionData.linkedCaseId)).data)
        )
        || (
          sessionData.get('linkedCaseId', null) == null
          && sessionData.get('ownerUid', '') == uid()
          && (
            (
              sessionData.get('workspaceType', '') == 'hospital'
              && hasActiveHospitalMembership(uid(), sessionData.get('hospitalId', ''))
            )
            || (
              sessionData.get('workspaceType', '') == 'individual'
            )
          )
        )
      );
    }

    // Enforces the Scribe session -> ClinicalCase workspace invariant.
    // Hospital sessions may link only to the same hospital (modern case) or
    // an accessible legacy case of that same verified hospital membership.
    // Individual sessions may link only to the owner's individual case.
    function canLinkSessionToCase(sessionData, caseData) {
      return isLoggedIn() && (
        isPlatformAdmin()
        || (
          sessionData.get('workspaceType', '') == 'hospital'
          && sessionData.get('hospitalId', '') is string
          && sessionData.get('hospitalId', '') != ''
          && hasActiveHospitalMembership(uid(), sessionData.get('hospitalId', ''))
          && (
            (
              caseData.get('workspaceType', '') == 'hospital'
              && caseData.get('hospitalId', '') == sessionData.get('hospitalId', '')
            )
            || (
              !('workspaceType' in caseData)
              && canAccessLegacyHospital(caseData.get('hospital', ''))
            )
          )
        )
        || (
          sessionData.get('workspaceType', '') == 'individual'
          && sessionData.get('ownerUid', '') == uid()
          && caseData.get('workspaceType', '') == 'individual'
          && caseData.get('ownerUid', '') == sessionData.get('ownerUid', '')
        )
      );
    }

    // ── Cases ─────────────────────────────────────────────────
    // - New cases must be ownership-aware (hospital or individual).
    // - Legacy cases (no workspaceType) remain accessible via verified
    //   membership matching case.hospital (hospitalName / legacyHospitalNames).
    // - A case's hospital can never be changed by a client.
    // - Only the platform admin can hard-delete.

    match /cases/{caseId} {
      allow read: if canAccessCase(resource.data);

      allow create: if isLoggedIn() && (
        isPlatformAdmin()
        || isValidHospitalCaseCreate(incoming())
        || isValidIndividualCaseCreate(incoming())
      );

      allow update: if isLoggedIn() && (
        isPlatformAdmin()
        ||
        (
          'workspaceType' in existing()
          && incoming().workspaceType == existing().workspaceType
          && incoming().createdByUid == existing().createdByUid
          && incoming().get('hospitalId', null) == existing().get('hospitalId', null)
          && incoming().get('ownerUid', null) == existing().get('ownerUid', null)
          && (
            (
              existing().workspaceType == 'hospital'
              && hasActiveHospitalMembership(uid(), existing().hospitalId)
            )
            ||
            (
              existing().workspaceType == 'individual'
              && existing().ownerUid == uid()
            )
          )
        )
        ||
        (
          // Legacy case: clinical updates allowed; no Phase-3 field injection;
          // hospital label frozen.
          !('workspaceType' in existing())
          && canAccessLegacyHospital(existing().get('hospital', ''))
          && !('workspaceType' in incoming())
          && !('ownerUid' in incoming())
          && !('hospitalId' in incoming())
          && !('createdByUid' in incoming())
          && incoming().get('hospital', '') == existing().get('hospital', '')
        )
      );

      allow delete: if isPlatformAdmin();

      match /{subcollection}/{subDoc=**} {
        allow read, create, update, delete: if
          canAccessCase(get(/databases/$(database)/documents/cases/$(caseId)).data);
      }
    }

    // ── Scribe Sessions ───────────────────────────────────────

    match /scribeSessions/{sessionId} {
      allow read: if canAccessSession(resource.data);

      allow create: if isLoggedIn() && (
        isPlatformAdmin()
        || isValidHospitalSessionCreate(incoming())
        || isValidIndividualSessionCreate(incoming())
      );

      allow update: if isLoggedIn() && (
        isPlatformAdmin()
        || (
          incoming().ownerUid == existing().ownerUid
          && incoming().workspaceType == existing().workspaceType
          && incoming().get('hospitalId', null) == existing().get('hospitalId', null)
          && incoming().get('createdAt', null) == existing().get('createdAt', null)
          && (
            incoming().get('linkedCaseId', null) == existing().get('linkedCaseId', null)
            || (
              existing().get('linkedCaseId', null) == null
              && incoming().get('linkedCaseId', null) != null
              && exists(/databases/$(database)/documents/cases/$(incoming().linkedCaseId))
              && canLinkSessionToCase(
                existing(),
                get(/databases/$(database)/documents/cases/$(incoming().linkedCaseId)).data
              )
            )
          )
          && canAccessSession(resource.data)
        )
      );

      allow delete: if isPlatformAdmin();

      match /messages/{messageId} {
        allow read, write: if
          exists(/databases/$(database)/documents/scribeSessions/$(sessionId))
          && canAccessSession(get(/databases/$(database)/documents/scribeSessions/$(sessionId)).data);
      }
    }

    // ── Department case copies ────────────────────────────────
    // deptId must match the member's hospitalId / hospitalName / hospital or
    // one of legacyHospitalNames (department slugs must be added to
    // legacyHospitalNames during migration if these copies are still read).

    match /departments/{deptId}/cases/{caseId} {
      allow read: if isLoggedIn() &&
        (canAccessLegacyHospital(deptId) || isPlatformAdmin());
      allow create: if isLoggedIn() &&
        (canAccessLegacyHospital(deptId) || isPlatformAdmin());
      allow update: if isLoggedIn()
        && (canAccessLegacyHospital(deptId) || isPlatformAdmin())
        && incoming().get('hospital', '') == existing().get('hospital', '')
        && incoming().get('departmentId', '') == existing().get('departmentId', '');
      allow delete: if isPlatformAdmin();

      match /addenda/{addendumId} {
        allow read, create, update, delete: if isLoggedIn() &&
          (canAccessLegacyHospital(deptId) || isPlatformAdmin());
      }
    }

    // ── Users ─────────────────────────────────────────────────
    // - users.hospital is DISPLAY-ONLY and carries no authority. Clients may
    //   not set it at sign-up nor change it later; only the backend (Admin SDK,
    //   on invite accept / approval / leave) writes it.
    // - hospitalLabel is a free-text display field the doctor may edit.
    // - role, aiCredits, subscriptionTier: never self-editable.
    // - Only the platform admin may edit another user's profile.

    match /users/{userId} {
      allow read: if isLoggedIn();

      allow create: if isLoggedIn() && isOwner(userId)
        && incoming().name is string && incoming().name.size() <= 100
       && incoming().email is string
&& incoming().email.size() <= 100
&& ('email' in request.auth.token)
&& request.auth.token.email is string
&& incoming().email.lower()
     == request.auth.token.email.lower()
        && incoming().role in ['EM Resident', 'Resident', 'resident', 'Doctor', 'Physician', 'Emergency Physician']
        && (!('hospital' in incoming()) || incoming().hospital == '')
        && (!('hospitalLabel' in incoming()) || (incoming().hospitalLabel is string && incoming().hospitalLabel.size() <= 100))
        && incoming().get('aiCredits', 100) == 100
        && incoming().get('streak', 1) == 1
      && incoming().get('subscriptionTier', 'Free Standard')
     == 'Free Standard';

      allow update: if isLoggedIn()
        && (
          isPlatformAdmin()
          ||
         (
  isOwner(userId)

  // Profile email must remain bound to Firebase Auth identity.
  && ('email' in request.auth.token)
  && request.auth.token.email is string
  && incoming().email is string
  && incoming().email.lower()
       == request.auth.token.email.lower()

  && (!('role' in incoming())
      || incoming().role == existing().get('role', null))

  && (!('aiCredits' in incoming())
      || incoming().aiCredits == existing().get('aiCredits', null))

  && (!('subscriptionTier' in incoming())
      || incoming().subscriptionTier
           == existing().get('subscriptionTier', null))

  && incoming().get('hospital', '')
       == existing().get('hospital', '')
)
        )
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().role is string && incoming().role.size() <= 100
        && (!('hospital' in incoming()) || (incoming().hospital is string && incoming().hospital.size() <= 100))
        && (!('hospitalLabel' in incoming()) || (incoming().hospitalLabel is string && incoming().hospitalLabel.size() <= 100))
        && (incoming().get('aiCredits', 0) is int)
        && (incoming().get('streak', 0) is int)
        && (incoming().get('subscriptionTier', '') is string);

      // Personal discussion sessions — private to the owning doctor.
      match /discussions/{discussionId} {
        allow read, create, update, delete: if isLoggedIn() && isOwner(userId);

        match /messages/{messageId} {
          allow read, create, update, delete: if isLoggedIn() && isOwner(userId);
        }
      }

      match /meta/{metaDocId} {
        allow read, write: if isLoggedIn() && isOwner(userId);
      }

      // My Log Book — private to the owning doctor. Created only by the
      // backend; the owner may edit only learningPoints / skills / updatedAt.
      match /logbook/{entryId} {
        allow read, delete: if isLoggedIn() && isOwner(userId);
        allow create: if false;
        allow update: if isLoggedIn() && isOwner(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['learningPoints', 'skills', 'updatedAt'])
          && (!('learningPoints' in incoming()) || incoming().learningPoints is string)
          && (!('skills' in incoming()) || incoming().skills is list)
          && (!('updatedAt' in incoming()) || incoming().updatedAt is string);
      }
    }

    // ── Role Change Requests ──────────────────────────────────

    match /roleChangeRequests/{requestId} {
      allow read: if isLoggedIn()
        && (resource.data.get('requestedBy', '') == uid() || isPlatformAdmin());
      allow create: if isLoggedIn()
        && incoming().requestedBy == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isLoggedIn()
        && (
          (
            existing().get('requestedBy', '') == uid()
            && incoming().get('requestedBy', '') == existing().get('requestedBy', '')
            && existing().get('status', '') == 'pending'
            && incoming().get('status', '') == 'rejected'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || isPlatformAdmin()
        );
      allow delete: if false;
    }

    // ── Role Change Audit Log (NABH) — append-only, admin/backend only ──

    match /roleChangeLog/{logId} {
      allow read: if isPlatformAdmin();
     allow create: if false;
      allow update, delete: if false;
    }
// ── Team Security Audit Log — backend-write only ──────────
//
// All lifecycle audit events are written by the trusted
// Express/Firebase Admin backend.
//
// Browser clients must never create, modify, or delete
// security audit records.
match /teamAuditLog/{logId} {
  allow read: if isPlatformAdmin();
  allow write: if false;
}

// ── Teams / Workspaces — trusted backend only ──────────
match /teams/{teamId} {
  allow read: if isLoggedIn();
  allow write: if false;
}
    // ── HOD Claim Requests (bootstrapping gate) ───────────────

    match /hodClaimRequests/{claimId} {
      allow create: if isLoggedIn()
        && incoming().claimedByUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().hospital is string
        && incoming().place is string
        && incoming().state is string
        && incoming().pincode is string;

      allow read: if isLoggedIn()
        && (
          resource.data.claimedByUid == request.auth.uid
          || isPlatformAdmin()
        );

      allow update: if isPlatformAdmin();
    }

    // ── Handovers ─────────────────────────────────────────────
    // Scoped by verified membership; the hospital label is frozen on update.

    match /handovers/{handoverId} {
      allow read, delete: if sameHospital(resource.data.get('hospital', ''));
      allow update: if sameHospital(resource.data.get('hospital', ''))
        && incoming().get('hospital', '') == existing().get('hospital', '');
      allow create: if isLoggedIn() && sameHospital(incoming().get('hospital', ''));
    }

    match /handoverPatients/{patientId} {
      allow read, delete: if sameHospital(resource.data.get('hospital', ''));
      allow update: if sameHospital(resource.data.get('hospital', ''))
        && incoming().get('hospital', '') == existing().get('hospital', '');
      allow create: if isLoggedIn() && sameHospital(incoming().get('hospital', ''));
    }

    match /handover_patients/{patientId} {
      allow read, delete: if sameHospital(resource.data.get('hospital', ''));
      allow update: if sameHospital(resource.data.get('hospital', ''))
        && incoming().get('hospital', '') == existing().get('hospital', '');
      allow create: if isLoggedIn() && sameHospital(incoming().get('hospital', ''));
    }

    // ── Quick Paste ───────────────────────────────────────────
    // Hospital records are restricted to verified members of that hospital.
    // Creator identity is bound to the authenticated user at CREATE and is
    // immutable afterward. Independent items remain creator-only.

    match /quick_paste_patients/{itemId} {
      allow read: if isLoggedIn()
        && (
          isPlatformAdmin()
          || (
            resource.data.get('hospital', '') != ''
            && canAccessLegacyHospital(resource.data.get('hospital', ''))
          )
          || (
            resource.data.get('hospital', '') == ''
            && ('email' in request.auth.token)
            && request.auth.token.email != null
            && resource.data.get('createdByEmail', '') != ''
            && resource.data.get('createdByEmail', '').lower() == request.auth.token.email.lower()
          )
        );

      allow create: if isLoggedIn()
        && (
          isPlatformAdmin()
          || (
            incoming().get('hospital', '') != ''
            && canAccessLegacyHospital(incoming().get('hospital', ''))
            && incoming().get('createdByUid', '') == uid()
            && ('email' in request.auth.token)
            && request.auth.token.email != null
            && incoming().get('createdByEmail', '') != ''
            && incoming().get('createdByEmail', '').lower() == request.auth.token.email.lower()
          )
          || (
            incoming().get('hospital', '') == ''
            && ('email' in request.auth.token)
            && request.auth.token.email != null
            && incoming().get('createdByEmail', '') != ''
            && incoming().get('createdByEmail', '').lower() == request.auth.token.email.lower()
            && (
              !('createdByUid' in incoming())
              || incoming().get('createdByUid', '') == uid()
            )
          )
        );

      allow update: if isLoggedIn()
        && (
          isPlatformAdmin()
          || (
            (
              (
                resource.data.get('hospital', '') != ''
                && canAccessLegacyHospital(resource.data.get('hospital', ''))
              )
              || (
                resource.data.get('hospital', '') == ''
                && ('email' in request.auth.token)
                && request.auth.token.email != null
                && resource.data.get('createdByEmail', '') != ''
                && resource.data.get('createdByEmail', '').lower() == request.auth.token.email.lower()
              )
            )
            && incoming().get('hospital', '') == existing().get('hospital', '')
            && incoming().get('createdByEmail', '') == existing().get('createdByEmail', '')
            && incoming().get('createdByUid', '') == existing().get('createdByUid', '')
          )
        );

      allow delete: if isLoggedIn()
        && (
          isPlatformAdmin()
          || (
            resource.data.get('hospital', '') != ''
            && canAccessLegacyHospital(resource.data.get('hospital', ''))
          )
          || (
            resource.data.get('hospital', '') == ''
            && ('email' in request.auth.token)
            && request.auth.token.email != null
            && resource.data.get('createdByEmail', '') != ''
            && resource.data.get('createdByEmail', '').lower() == request.auth.token.email.lower()
          )
        );
    }

    // ── Team members ──────────────────────────────────────────
    // - create / delete: trusted backend (Admin SDK) only.
    // - update: own shift, or an exact verified HOD of the same hospital
    //   changing a colleague's shift. Only ['shift','updatedAt'] may change.

    match /team_members/{memberId} {
      allow read: if isLoggedIn()
        && (
          memberId == uid()
          || isPlatformAdmin()
          || hasActiveHospitalMembership(uid(), resource.data.get('hospitalId', resource.data.get('hospital', '')))
          || (
            resource.data.get('hospitalId', null) == null
            && canAccessLegacyHospital(resource.data.get('hospital', ''))
          )
        );

     allow create, delete: if false;

     allow update: if (
          isLoggedIn()
          && isValidId(memberId)
          && userHasActiveHospitalMembership(uid())
          && incoming().diff(existing()).affectedKeys().hasOnly(['shift', 'updatedAt'])
          && incoming().shift is string && incoming().shift.size() <= 50
          && (!('updatedAt' in incoming()) || incoming().updatedAt is string)
          && (
            memberId == uid()
            || isRotaManagerFor(existing().get('hospitalId', existing().get('hospital', '')))
          )
        );
    }

  // ── Hospital subscriptions — trusted backend / payment webhook only ──

    match /hospital_subscriptions/{hospitalId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if false;
    }

    // ── Team Invites — trusted backend only (creation, revocation, regeneration via API) ──

    match /teamInvites/{token} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    // ── Hospital shift configuration — readable by all, editable by authorized Rota Managers and HODs ──

   match /hospital_shifts/{hospitalId} {
  allow read: if isLoggedIn();

  // Shift configuration and facility settings may be created/updated by
  // an authorized Rota Manager, active verified HOD, or platform admin.
  allow create, update: if isLoggedIn()
    && hospitalId is string
    && hospitalId.size() > 0
    && (
      isPlatformAdmin()
      || isRotaManagerFor(hospitalId)
    )

    // The document identity must match its Firestore path.
    && incoming().id == hospitalId
    && incoming().hospitalId == hospitalId

    // Only the expected shift-configuration and facility fields may exist.
    && incoming().keys().hasOnly([
      'id',
      'hospitalId',
      'hospital',
      'shifts',
      'erPhysicalBedCapacity',
      'updatedAt',
      'updatedByUid',
      'updatedByEmail'
    ])

    // Basic field integrity.
    && incoming().hospital is string
    && (!('shifts' in incoming()) || incoming().shifts is list)
    && (!('erPhysicalBedCapacity' in incoming()) || (
      incoming().erPhysicalBedCapacity is int
      && incoming().erPhysicalBedCapacity > 0
      && incoming().erPhysicalBedCapacity <= 1000
    ))
    && (('shifts' in incoming()) || ('erPhysicalBedCapacity' in incoming()))
    && incoming().updatedAt is string

    // The authenticated clinician must be recorded
    // as the person performing the update.
    && incoming().updatedByUid == uid()
    && incoming().updatedByEmail is string;

  // There is no legitimate client-side delete workflow.
  allow delete: if false;
}

    // ── Contributions (educational content, non-clinical) ─────

    match /contributions/{contributionId} {
      allow read: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        isPlatformAdmin()
        || (
          ('email' in request.auth.token)
          && resource.data.get('submitterEmail', '') != ''
          && resource.data.submitterEmail.lower() == request.auth.token.email.lower()
        )
      );
      allow create: if isLoggedIn()
        && isValidId(contributionId)
        && incoming().id == contributionId
        && incoming().title is string && incoming().title.size() <= 150
        && incoming().mnemonic is string && incoming().mnemonic.size() <= 100
        && incoming().category is string && incoming().category.size() <= 100
        && incoming().breakdown is string && incoming().breakdown.size() <= 2000
        && incoming().status == 'pending'
        && incoming().submittedBy is string && incoming().submittedBy.size() <= 100
        && ('email' in request.auth.token)
        && incoming().submitterEmail.lower() == request.auth.token.email.lower();
     allow update: if isLoggedIn()
  && isValidId(contributionId)
  && (
    (
      isPlatformAdmin()
      && incoming().status == 'approved'
      && incoming()
           .diff(existing())
           .affectedKeys()
           .hasOnly(['status'])
    )
    ||
    (
      ('email' in request.auth.token)
      && resource.data.get('submitterEmail', '') != ''
      && resource.data.submitterEmail.lower()
         == request.auth.token.email.lower()

      && existing().get('status', '') == 'pending'

      && incoming()
           .diff(existing())
           .affectedKeys()
           .hasOnly([
             'title',
             'mnemonic',
             'category',
             'breakdown',
             'explanation'
           ])
    )
  );
}

// ── Mortality Audits (confidential, medico-legal) ─────────
    // Readable/writable only by a verified exact HOD of the audit's own
    // hospital. The hospital of an audit can never be changed. Untenanted
    // audits: platform admin only. Delete: platform admin only.

    match /mortalityAudits/{auditId} {
      allow read: if isLoggedIn()
        && (
          isPlatformAdmin()
          || (
            resource.data.get('hospitalId', '') is string 
            && resource.data.get('hospitalId', '') != ''
            && isHospitalAdminFor(resource.data.hospitalId)
          )
          || (
            resource.data.get('hospitalId', null) == null
            && resource.data.get('hospital', '') != ''
            && isHospitalAdminFor(resource.data.hospital)
          )
        );

     allow create: if isLoggedIn()
  && (
    // Platform admin may create administrative / legacy records.
    isPlatformAdmin()

    ||

    // All normal HOD-created audits must use the canonical hospitalId.
    (
      incoming().get('hospitalId', '') is string
      && incoming().get('hospitalId', '').size() > 0
      && isHospitalAdminFor(
        incoming().get('hospitalId', '')
      )
    )
  );

     allow update: if isLoggedIn()

  // Audit tenant identity is immutable for every browser client,
  // including the platform-admin account.
  && incoming().get('hospitalId', null)
       == existing().get('hospitalId', null)

  && incoming().get('hospital', null)
       == existing().get('hospital', null)

  && (
    isPlatformAdmin()

    || (
      (
        existing().get('hospitalId', '') is string
        && existing().get('hospitalId', '') != ''
        && isHospitalAdminFor(
          existing().hospitalId
        )
      )

      || (
        existing().get('hospitalId', null) == null
        && existing().get('hospital', '') != ''
        && isHospitalAdminFor(
          existing().hospital
        )
      )
    )
  );

   allow delete: if isLoggedIn()
  && (
    // Platform admin may delete any mortality audit.
    isPlatformAdmin()

    ||

    // Verified HOD may delete an audit belonging
    // to their own canonical hospital.
    (
      resource.data.get('hospitalId', '') is string
      && resource.data.get('hospitalId', '') != ''
      && isHospitalAdminFor(
        resource.data.get('hospitalId', '')
      )
    )

    ||

    // Compatibility for existing legacy audits
    // that have only the old hospital field.
    (
      resource.data.get('hospitalId', null) == null
      && resource.data.get('hospital', '') != ''
      && isHospitalAdminFor(
        resource.data.get('hospital', '')
      )
    )
  );
    }

    // ── Bound Chat Sessions — creator-only ────────────────────
match /chatSessions/{sessionId} {

  // Existing session remains visible/deletable only to
  // its creator or the platform admin.
  allow read, delete: if isLoggedIn()
    && (
      resource.data.get('createdBy', '') == uid()
      || isPlatformAdmin()
    );

  // Ownership is immutable after creation.
  allow update: if isLoggedIn()
    && (
      resource.data.get('createdBy', '') == uid()
      || isPlatformAdmin()
    )
    && incoming().get('createdBy', '')
         == existing().get('createdBy', '');

  // A normal user may create only a session owned by themselves.
  allow create: if isLoggedIn()
    && (
      incoming().get('createdBy', '') == uid()
      || isPlatformAdmin()
    );
}

    // ── Payment intents — server only ─────────────────────────

    match /paymentIntents/{orderId} {
      allow read, write: if false;
    }

    // ── Case Counters (atomic daily clinical sequence YYMMDD###) ──
    match /case_counters/{counterDate} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && incoming().keys().hasOnly(['dateKey', 'lastSequence', 'updatedAt'])
        && incoming().dateKey == counterDate
        && incoming().lastSequence == 1
        && incoming().updatedAt is string;
      allow update: if isLoggedIn()
        && incoming().keys().hasOnly(['dateKey', 'lastSequence', 'updatedAt'])
        && incoming().dateKey == existing().dateKey
        && incoming().lastSequence is int
        && incoming().lastSequence == existing().lastSequence + 1
        && incoming().lastSequence <= 999
        && incoming().updatedAt is string;
      allow delete: if false;
    }
  }
}
