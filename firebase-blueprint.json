{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "hospital": { "type": "string" },
        "aiCredits": { "type": "integer" },
        "streak": { "type": "integer" },
        "subscriptionTier": { "type": "string" }
      },
      "required": ["name", "email", "role", "hospital"]
    },
    "ClinicalCase": {
      "title": "ClinicalCase",
      "description": "Structured medical case sheet documentation for an ER patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patient": { "type": "object" },
        "vitals": { "type": "object" },
        "sampleHistory": { "type": "object" },
        "primaryAssessment": { "type": "object" },
        "secondaryAssessment": { "type": "string" },
        "investigations": { "type": "array" },
        "treatments": { "type": "array" },
        "progressNotes": { "type": "string" },
        "dischargeInfo": { "type": "object" },
        "differentials": { "type": "array" },
        "isPediatric": { "type": "boolean" },
        "status": { "type": "string" },
        "savedTime": { "type": "string" },
        "timeSpentMin": { "type": "integer" },
        "doctorEmail": { "type": "string" },
        "doctorName": { "type": "string" }
      },
      "required": ["id", "patient", "vitals", "status"]
    },
    "HandoverRecord": {
      "title": "HandoverRecord",
      "description": "Structured shift handover report detailing patients transferred and shift transition info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "timestamp": { "type": "string" },
        "caseCount": { "type": "integer" },
        "patientsText": { "type": "string" },
        "acknowledgedBy": { "type": "string" },
        "acknowledgedTime": { "type": "string" }
      },
      "required": ["id", "senderName", "senderEmail", "timestamp", "caseCount", "patientsText"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Hospital team member with clinical role and assigned shift",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "shift": { "type": "string" },
        "hospital": { "type": "string" },
        "assignedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "hospital", "shift"]
    },
    "HospitalSubscription": {
      "title": "HospitalSubscription",
      "description": "Hospital group license and team subscription status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hospital": { "type": "string" },
        "subscriptionTier": { "type": "string" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "hospital", "subscriptionTier", "active"]
    },
    "Contribution": {
      "title": "Contribution",
      "description": "User suggested mnemonic or clinical guideline contribution",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "mnemonic": { "type": "string" },
        "category": { "type": "string" },
        "breakdown": { "type": "string" },
        "explanation": { "type": "string" },
        "status": { "type": "string" },
        "submittedBy": { "type": "string" },
        "submitterEmail": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "mnemonic", "category", "breakdown", "status", "submittedBy", "submitterEmail"]
    },
    "QuickPastePatient": {
      "title": "QuickPastePatient",
      "description": "EMR Quick Paste handover patient card synced across devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ageGender": { "type": "string" },
        "triage": { "type": "string" },
        "vitals": { "type": "string" },
        "rawNotes": { "type": "string" },
        "structuredSBAR": { "type": "object" },
        "hospital": { "type": "string" },
        "createdByEmail": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/contributions/{contributionId}": {
      "schema": "Contribution",
      "description": "Suggested mnemonics and clinical guidelines pending review"
    },
    "/quick_paste_patients/{itemId}": {
      "schema": "QuickPastePatient",
      "description": "EMR Quick Paste roster patients synced across devices"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles keyed by auth.uid"
    },
    "/cases/{caseId}": {
      "schema": "ClinicalCase",
      "description": "Clinical cases logged or managed in the ER"
    },
    "/handovers/{handoverId}": {
      "schema": "HandoverRecord",
      "description": "Recorded shift handovers between shifts/doctors"
    },
    "/team_members/{memberId}": {
      "schema": "TeamMember",
      "description": "Whitelisted team members and shift assignments"
    },
    "/hospital_subscriptions/{hospitalId}": {
      "schema": "HospitalSubscription",
      "description": "Shared hospital subscription status for teams"
    }
  }
}
