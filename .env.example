# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SARVAM_API_KEY: Subscription key for Sarvam AI voice services (ASR & TTS).
# Configure this via the Secrets panel in the AI Studio UI for voice features.
SARVAM_API_KEY="MY_SARVAM_API_KEY"

# ANTHROPIC_API_KEY: Optional API key for Anthropic Claude Sonnet EMR Handover extraction.
# If provided, shift handover EMR extraction uses Claude 3.5 Sonnet; otherwise defaults to Gemini Flash.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# OPENAI_API_KEY: Optional API key for OpenAI GPT-4o-mini voice dictation section extraction.
# If provided, voice clinical section extraction uses OpenAI GPT-4o-mini; otherwise defaults to Gemini Flash.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
